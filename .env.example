FAKE_LLM=true
FAKE_LLM_DELAY_SECONDS=0.2
# 학교 예시 모델. 실제 계정 접근 여부는 별도 확인합니다.
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=600
# 실제 호출 시 FAKE_LLM=false로 바꾸고 로컬 .env에 키를 설정하세요.
# OPENAI_API_KEY=본인_키

# L01/L02: local은 Python 함수 검사, nemo는 별도 security-runtime 환경이 필요합니다.
GUARDRAIL_BACKEND=local
RISK_TTL_SECONDS=1800
RISK_MAX_SESSIONS=1000
RISK_BLOCK_THRESHOLD=3
