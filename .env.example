FAKE_LLM=true
FAKE_LLM_DELAY_SECONDS=0.2
# 학교 예시 모델. 실제 계정 접근 여부는 별도 확인합니다.
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=600
# 실제 호출 시 FAKE_LLM=false로 바꾸고 로컬 .env에 키를 설정하세요.
# OPENAI_API_KEY=본인_키

# L01/L02: local은 Python 함수 검사, nemo는 별도 security-runtime 환경이 필요합니다.
GUARDRAIL_BACKEND=local
RISK_TTL_SECONDS=1800
RISK_MAX_SESSIONS=1000
RISK_BLOCK_THRESHOLD=3
# Single-worker capacity and USD budget ledger. No automatic reset/persistence.
GENERATION_CONCURRENT=2
GENERATION_WAITERS=4
GENERATION_WAIT_SECONDS=0.5
GENERATION_TIMEOUT_SECONDS=30
BUDGET_LIMIT_USD=1.00
# Operator-set estimate reserved per call; this is not a verified provider price.
GENERATION_RESERVATION_USD=0.01
# Configure BOTH prices to compute REPORTED cost from provider token usage.
# Real service calls require BOTH prices before acquiring resources or calling AI.
# Started calls without reported usage settle as ESTIMATED, including failures.
# INPUT_USD_PER_MILLION_TOKENS=
# OUTPUT_USD_PER_MILLION_TOKENS=
# Synthetic RAG learning only; API connection is not implemented in v1.
RAG_ENABLED=false
